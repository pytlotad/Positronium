{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git Auto Commit on Save",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/git-auto-commit.sh",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
