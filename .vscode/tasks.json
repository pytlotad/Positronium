{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git Auto Commit on Save",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/git-auto-commit.sh",
      "problemMatcher": {
        "owner": "git-auto-commit",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Watching repository for saved files\\.\\.\\.$",
          "endsPattern": "^Watches established\\.$"
        }
      },
      "isBackground": true,
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
